{
  "name": "motion-runtime-os",
  "version": "0.2.0",
  "private": true,
  "description": "Executable Motion Runtime OS with provider-neutral IR and Remotion adapter",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render:intro": "remotion render src/index.ts CinematicIntro out/cinematic-intro.mp4",
    "validate:ir": "node scripts/validate-motion-ir.mjs",
    "qa:static": "node scripts/qa-static.mjs",
    "provider:conformance": "node scripts/provider-conformance.mjs",
    "artifact:manifest": "node scripts/generate-artifact-manifest.mjs",
    "qa:run": "npm run validate:ir && npm run qa:static && npm run provider:conformance && npx tsc --noEmit",
    "test": "npm run qa:run && npm run build"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.516"
  },
  "devDependencies": {
    "@types/node": "20.12.14",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
